@model IEnumerable<firstASP.Models.Customer>

<h1>Customers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Customer</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Contact Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>Zip Code</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.CustomerName</td>
                <td>@customer.ContactName</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.Address</td>
                <td>@customer.City</td>
                <td>@customer.State</td>
                <td>@customer.ZipCode</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@customer.CustomerId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@customer.CustomerId"
                          method="post"
                          style="display:inline">
                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>