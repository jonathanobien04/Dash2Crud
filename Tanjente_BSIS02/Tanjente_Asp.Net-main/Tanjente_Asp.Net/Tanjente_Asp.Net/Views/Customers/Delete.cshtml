@model Tanjente_Asp.Net.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>
<h3>Are you sure you want to delete this customer?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-3">Customer Name</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>
    <dt class="col-sm-3">Contact Name</dt>
    <dd class="col-sm-9">@Model.ContactName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" name="id" value="@Model.CustomerName" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>